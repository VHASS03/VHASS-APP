# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vhass_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (required, at least 32 characters — the server refuses to start otherwise)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars

# OTP Configuration
OTP_EXPIRY_SECONDS=600
OTP_LENGTH=6
# Return the OTP to the app (API response + Socket.IO). Insecure: anyone with a phone
# number could log in. Defaults to true outside NODE_ENV=production. Set to false once
# Twilio is configured below.
EXPOSE_OTP_IN_RESPONSE=

# Twilio (server-side OTP / SOS SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SOS Configuration
SOS_ESCALATION_DELAY_SECONDS=30
SOS_MAX_DURATION_SECONDS=3600
EMERGENCY_NUMBER=112

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000
# Gemini API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
# Groq chat (AI companion). llama-3.1-70b-versatile and mixtral were retired by Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
